#!/usr/bin/env python3
"""Shani Chronoa background mode: automatic rules and senses without the window.

Started by the systemd user unit shani-chronoa-daemon.service. See
shani_chronoa/daemon.py.
"""

import sys
import os

# See usr/bin/shani-chronoa for why this is usr/lib/shani-chronoa, not just
# dirname(dirname(__file__)) - the package lives one directory deeper.
_USR_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(_USR_DIR, "lib", "shani-chronoa"))

from shani_chronoa.daemon import main

if __name__ == "__main__":
    sys.exit(main())
