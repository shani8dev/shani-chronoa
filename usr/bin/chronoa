#!/usr/bin/env python3
"""Chronoa in the terminal: a client of the Agent engine, not a second brain.

Run `chronoa` for the interactive prompt, or `chronoa -p "question"` for one
answer. Everything is decided by dev.shani.chronoa.Agent over the session bus.
"""

import os
import sys

# Same path fix as usr/bin/shani-chronoa: the package lives at
# usr/lib/shani-chronoa/shani_chronoa, one directory deeper than usr/bin.
_USR_DIR = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(_USR_DIR, "lib", "shani-chronoa"))

from shani_chronoa.tui.cli import main

if __name__ == "__main__":
    raise SystemExit(main())
