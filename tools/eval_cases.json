{
  "about": "Chronoa task eval: what a person says, and the tool call a correct assistant makes. Checked, never executed. Each 'expect' entry is one acceptable call: 'tool' must match, and every key in 'args' must match its rule - a number equals (5 == 5.0), a string is compared case-insensitively and may be a list of acceptable values, a string starting with '~' must be contained, '*' only requires the key to be present. 'none': true means no tool should be called. 'ask': true also accepts ask_user.",
  "cases": [
    {"id": "time", "say": "What time is it?", "expect": [{"tool": "get_datetime"}]},
    {"id": "date", "say": "what's today's date", "expect": [{"tool": "get_datetime"}]},
    {"id": "timer-5min", "say": "Set a timer for 5 minutes.", "expect": [{"tool": "set_timer", "args": {"seconds": 300}}]},
    {"id": "timer-90s-label", "say": "timer 90 seconds for the eggs", "expect": [{"tool": "set_timer", "args": {"seconds": 90, "label": "~egg"}}]},
    {"id": "timer-list", "say": "what timers do I have running?", "expect": [{"tool": "set_timer", "args": {"action": "list"}}]},
    {"id": "reminder", "say": "Remind me to call mom tomorrow at 6pm", "expect": [{"tool": "add_reminder", "args": {"text": "~mom"}}]},
    {"id": "volume-set", "say": "set the volume to 40 percent", "expect": [{"tool": "set_volume", "args": {"percent": 40}}]},
    {"id": "volume-get", "say": "how loud is it right now?", "expect": [{"tool": "get_volume"}]},
    {"id": "mute", "say": "mute the sound", "expect": [{"tool": "set_mute", "args": {"mute": true}}]},
    {"id": "brightness", "say": "make the screen brightness 70", "expect": [{"tool": "set_brightness", "args": {"level": 70}}]},
    {"id": "battery", "say": "How much battery do I have left?", "expect": [{"tool": "get_battery_status"}]},
    {"id": "weather", "say": "What's the weather like in Pune?", "expect": [{"tool": "get_weather", "args": {"place": "~pune"}}, {"tool": "web_search", "args": {"query": "~pune"}}]},
    {"id": "world-time", "say": "what time is it in Tokyo", "expect": [{"tool": "get_world_time", "args": {"place": "~tokyo"}}]},
    {"id": "calc", "say": "what is 17 times 23", "expect": [{"tool": "calculate", "args": {"expression": "*"}}]},
    {"id": "percent", "say": "what's 15% of 2400", "expect": [{"tool": "calculate", "args": {"expression": "*"}}]},
    {"id": "units", "say": "convert 10 miles to kilometers", "expect": [{"tool": "convert_units", "args": {"value": 10, "from_unit": "~mi", "to_unit": "~k"}}]},
    {"id": "currency", "say": "how many rupees is 50 dollars", "expect": [{"tool": "convert_currency", "args": {"amount": 50, "from_currency": ["USD", "dollar", "dollars"], "to_currency": ["INR", "rupee", "rupees"]}}]},
    {"id": "days-until", "say": "how many days until Christmas?", "expect": [{"tool": "date_math", "args": {"operation": "days_until"}}]},
    {"id": "open-app", "say": "open firefox", "expect": [{"tool": "open_application", "args": {"name": "~firefox"}}]},
    {"id": "open-files", "say": "launch the file manager", "expect": [{"tool": "open_application", "args": {"name": "*"}}]},
    {"id": "screenshot", "say": "take a screenshot", "expect": [{"tool": "screenshot"}]},
    {"id": "lock", "say": "lock my screen", "expect": [{"tool": "lock_screen"}]},
    {"id": "media-pause", "say": "pause the music", "expect": [{"tool": "media_control", "args": {"action": ["pause", "toggle"]}}]},
    {"id": "media-next", "say": "skip to the next song", "expect": [{"tool": "media_control", "args": {"action": "next"}}]},
    {"id": "wifi-list", "say": "which wifi networks can you see?", "expect": [{"tool": "list_wifi_networks"}]},
    {"id": "internet", "say": "is my internet working?", "expect": [{"tool": "check_internet"}]},
    {"id": "ip", "say": "what's my IP address", "expect": [{"tool": "my_ip_address"}]},
    {"id": "bluetooth-list", "say": "show my bluetooth devices", "expect": [{"tool": "bluetooth_devices", "args": {"action": "list"}}]},
    {"id": "dnd", "say": "turn on do not disturb", "expect": [{"tool": "do_not_disturb", "args": {"enabled": true}}]},
    {"id": "night-light", "say": "switch on the night light", "expect": [{"tool": "toggle_night_light"}]},
    {"id": "dark-theme", "say": "switch to dark mode", "expect": [{"tool": "set_theme", "args": {"action": "~dark"}}]},
    {"id": "find-files", "say": "find my files with invoice in the name", "expect": [{"tool": "find_files", "args": {"pattern": "~invoice"}}, {"tool": "search_documents", "args": {"query": "~invoice"}}]},
    {"id": "list-downloads", "say": "what's in my Downloads folder?", "expect": [{"tool": "list_directory", "args": {"path": "~download"}}, {"tool": "directory_tree", "args": {"path": "~download"}}]},
    {"id": "read-file", "say": "read the file ~/notes/todo.txt", "expect": [{"tool": "read_text_file", "args": {"path": "~todo.txt"}}, {"tool": "read_document", "args": {"path": "~todo.txt"}}]},
    {"id": "write-file", "say": "write 'buy milk' into a new file ~/shopping.txt", "expect": [{"tool": "write_text_file", "args": {"path": "~shopping.txt", "content": "~milk"}}]},
    {"id": "disk", "say": "how much disk space is free?", "expect": [{"tool": "disk_usage"}, {"tool": "system_info"}]},
    {"id": "processes", "say": "what's using the most CPU right now?", "expect": [{"tool": "list_processes"}]},
    {"id": "updates", "say": "are there any system updates?", "expect": [{"tool": "check_updates"}]},
    {"id": "search-web", "say": "search the web for the latest news about ISRO", "expect": [{"tool": "web_search", "args": {"query": "~isro"}}]},
    {"id": "wiki", "say": "who was APJ Abdul Kalam?", "expect": [{"tool": "lookup_wikipedia", "args": {"topic": "~kalam"}}, {"tool": "web_search", "args": {"query": "~kalam"}}]},
    {"id": "define", "say": "what does ephemeral mean?", "expect": [{"tool": "define_word", "args": {"word": "~ephemeral"}}]},
    {"id": "translate", "say": "translate 'good morning' to Hindi", "expect": [{"tool": "translate_text", "args": {"text": "~good morning", "to_language": ["hi", "hindi"]}}]},
    {"id": "spell", "say": "how do you spell necessary?", "expect": [{"tool": "spell_word", "args": {"word": "~necessary"}}]},
    {"id": "password", "say": "generate a strong password", "expect": [{"tool": "generate_password"}]},
    {"id": "coin", "say": "flip a coin", "expect": [{"tool": "random_pick", "args": {"kind": "coin"}}]},
    {"id": "emoji", "say": "find me a rocket emoji", "expect": [{"tool": "find_emoji", "args": {"name": "~rocket"}}]},
    {"id": "clipboard-get", "say": "what's on my clipboard?", "expect": [{"tool": "get_clipboard"}]},
    {"id": "todo-add", "say": "add 'renew passport' to my to-do list", "expect": [{"tool": "todo_list", "args": {"content": "~passport"}}]},
    {"id": "new-chat", "say": "start a new conversation", "expect": [{"tool": "conversations", "args": {"action": "new"}}]},
    {"id": "past-chat", "say": "what did we talk about the router last week?", "expect": [{"tool": "conversations", "args": {"action": "search", "query": "~router"}}]},
    {"id": "draw", "say": "draw a lighthouse at sunset", "expect": [{"tool": "generate_image", "args": {"prompt": "~lighthouse"}}]},
    {"id": "photo-sepia", "say": "give ~/Pictures/beach.jpg a sepia look", "expect": [{"tool": "edit_image", "args": {"path": "~beach.jpg", "look": "sepia"}}]},
    {"id": "photo-faces", "say": "blur the faces in ~/Pictures/party.jpg before I share it", "expect": [{"tool": "photo_video", "args": {"action": "effect", "effect": "blur_faces", "path": "~party.jpg"}}]},
    {"id": "subtitles", "say": "make subtitles for ~/Videos/talk.mp4", "expect": [{"tool": "recording", "args": {"action": "subtitles", "path": "~talk.mp4"}}]},
    {"id": "who-said", "say": "who said what in ~/Music/meeting.m4a?", "expect": [{"tool": "recording", "args": {"action": "speakers", "path": "~meeting.m4a"}}]},
    {"id": "shutdown", "say": "shut down the computer", "expect": [{"tool": "power_action", "args": {"action": "shutdown"}}]},
    {"id": "qr", "say": "make a QR code for https://shani.dev", "expect": [{"tool": "qr_code", "args": {"action": "create", "text": "~shani.dev"}}]},
    {"id": "chat-joke", "say": "tell me a joke", "none": true},
    {"id": "chat-thanks", "say": "thanks, that's all", "none": true},
    {"id": "chat-explain", "say": "explain what a black hole is in two sentences", "none": true},
    {"id": "chat-hello", "say": "hello Chronoa!", "none": true},
    {"id": "vague-delete", "say": "delete it", "none": true, "ask": true}
  ]
}
