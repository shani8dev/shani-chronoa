__pycache__/
tests/__pycache__/
usr/**/__pycache__/
usr/**/*.pyc

# Scratch state for tools/mutate.py's redirected XDG_* directories, so a
# mutation run does not write into the developer's real home. Regenerated on
# every run; nothing here is a result.
build/

# Packaging moved to shani-pkgbuilds (shani-chronoa/PKGBUILD there); a local
# copy of pkg/ here is a stale duplicate of a tree this repo no longer owns.
pkg/
# makepkg output, from building that package in place.
*.pkg.tar.zst
# A stray WAV from a mistyped redirect (`cmd > -q`); it is a build artefact
# with no name, and nothing references it.
-q

# Downloaded voice and speech models kept between runs (tests/demos link to
# them instead of downloading again). Never committed: hundreds of MB.
cache/

# Android build output (APKs, classes, dex) - rebuilt by build.sh
android/*/build/
